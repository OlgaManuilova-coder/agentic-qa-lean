{
  "mcpServers": {
    "playwright-chrome": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.86",
        "--config",
        "config/mcp-playwright-chrome.config.json"
      ]
    },
    "playwright-firefox": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.86",
        "--config",
        "config/mcp-playwright-firefox.config.json"
      ]
    },
    "playwright-mobile": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.86",
        "--config",
        "config/mcp-playwright-mobile.config.json"
      ]
    }
  }
}
