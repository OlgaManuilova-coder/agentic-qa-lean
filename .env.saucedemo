# Environment: saucedemo — the public SauceDemo demo shop (https://www.saucedemo.com).
# Tracked in git. Everything here is PUBLIC: SauceDemo prints its demo logins and the shared
# password on its own login page. In a real project this file holds URLs/IDs only, never passwords
# (passwords go to .env.local or, in the Enterprise edition, to the OS credential store).

FRONT_URL=https://www.saucedemo.com

# Demo accounts (public). Each one triggers a different built-in behaviour of the demo app.
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_GLITCH_USER=performance_glitch_user
ERROR_USER=error_user
VISUAL_USER=visual_user

# Shared public demo password, shown on the SauceDemo login page.
USER_PASSWORD=secret_sauce
