# Cross-environment constants. Tracked in git. NO SECRETS here.
# Load order (later wins): .env.defaults -> .env.${TEST_ENV} -> .env.local
# Variable NAMES are stable across environments; only values change.

# Where agent runs write their reports, screenshots and JSON results (gitignored).
RESULTS_DIR=results

# Default checkout data used by the checkout suites.
CHECKOUT_FIRST_NAME=Test
CHECKOUT_LAST_NAME=Buyer
CHECKOUT_POSTAL_CODE=10001

# Max parallel browser lanes for regression runs (one Playwright MCP server per lane).
MAX_LANES=2
